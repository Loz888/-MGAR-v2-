  "scope": "Authorized P0 prerequisites then all P1 cards; P1-05 lifecycle/CLI/recovery and final P1 regression corrections only. P2 and later not implemented.",
  "audit_findings": [
    {
      "finding": "Ready task authorization survived revoked upstream verdict or forged current-plan labels",
      "resolution": "Claim/Start/Renew/Save revalidate actual membership, fixed input provenance/hash and current verdict after artifact locking; real PG contention tests."
    },
    {
      "finding": "Lifecycle verdict decisions and lease checks could become stale during lock waits",
      "resolution": "Lock current artifacts before fresh verdict reads; recheck orchestrator lease before controlled commit; real blocked-transaction tests."
    },
    {
      "finding": "CLI CreateRun then TakeOrchestrator allowed daemon to steal initial ownership",
      "resolution": "CreateRunClaimed atomically persists workflow, budget, initial lease, events and outbox; deterministic interleaving and rollback tests."
    },
    {
      "finding": "URI query options could reroute a seemingly synthetic DB target",
      "resolution": "Restrict URI query options and validate pgx resolved target/fallbacks as well as exact loopback port and synthetic DB namespace."
    },
    {
      "finding": "Go struct JSON decoding accepted case-folded fields and null string-array elements",
      "resolution": "Check exact raw JSON object keys, required nonnull values and array element types before typed decoding; negative tests."
    },
    {
      "finding": "Evidence fingerprint omitted contracts/docs/Compose/candidate files",
      "resolution": "Hash all Git tracked+candidate inputs except generated evidence and task queue; real temporary Git repository invalidation tests."
    },
    {
      "finding": "Typed edge-count hardening",
      "resolution": "Added explicit planner envelope bound and 96/97 boundary tests; pre-existing DAG layer already rejected 97, so no false red claim."
    },
    {
      "finding": "Final offline regression first failed isolated documentation-link fixture checks",
      "resolution": "Preserved raw failure. Added newly linked P1 docs to the temporary document fixture; unchanged validator and broken-link negative assertions. Targeted and full regressions rerun."
    }
  ],
  "review_evidence": "evidence/batches/P1-05/delegated-validation.json"
}
