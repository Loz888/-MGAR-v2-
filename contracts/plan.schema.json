{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mgar/v2/plan.schema.json",
  "title": "MGAR Candidate Plan V1",
  "type": "object",
  "required": ["schema_version", "base_version", "nodes", "edges", "rationale"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "plan.v1"},
    "base_version": {"type": "integer", "minimum": 0},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 24, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["node_key", "role", "goal", "required_inputs", "required_output_kind"],
      "properties": {
        "node_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"},
        "role": {"type": "string", "enum": ["research", "data", "action", "verify", "aggregate"]},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2048},
        "required_inputs": {"type": "array", "maxItems": 16, "items": {"type": "string"}, "uniqueItems": true},
        "required_output_kind": {"type": "string", "enum": ["finding", "sql_evidence", "patch", "verdict", "report"]}
      }
    }},
    "edges": {"type": "array", "maxItems": 96, "items": {
      "type": "object", "required": ["from", "to"], "additionalProperties": false,
      "properties": {"from": {"type": "string"}, "to": {"type": "string"}}
    }}
  }
}
