{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mgar/v2/context_snapshot.schema.json",
  "title": "MGAR Context Snapshot V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "plan_version", "model_config_version", "tool_policy_version", "artifacts"],
  "properties": {
    "context_selection": {
      "type": "object", "additionalProperties": false,
      "required": ["source_snapshot_sha256", "mode", "policy_version", "token_estimator", "items"],
      "properties": {
        "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"enum": ["full", "summary", "selected"]},
        "policy_version": {"const": "artifact-selector.v1"},
        "token_estimator": {"const": "utf8_bytes_div4.v1"},
        "items": {"type": "array", "maxItems": 64, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact_id", "content_sha256", "text", "original", "lossy", "verified"],
          "properties": {
            "artifact_id": {"type": "string", "format": "uuid"},
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "text": {"type": "string", "maxLength": 65536},
            "original": {"type": "boolean"}, "lossy": {"type": "boolean"}, "verified": {"const": false},
            "derived_artifact_uri": {"type": "string", "pattern": "^artifact://[0-9a-f-]{36}$"}
          },
          "allOf": [
            {"if": {"properties": {"original": {"const": true}}}, "then": {"properties": {"lossy": {"const": false}}, "not": {"required": ["derived_artifact_uri"]}}},
            {"if": {"properties": {"original": {"const": false}}}, "then": {"required": ["derived_artifact_uri"], "properties": {"lossy": {"const": true}}}}
          ]
        }}
      }
    },
    "snapshot_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "role": {"enum": ["research", "data", "action", "verify", "aggregate"]},
    "schema_version": {"const": "context.v1"},
    "task_id": {"type": "string", "format": "uuid"},
    "plan_version": {"type": "integer", "minimum": 1},
    "model_config_version": {"type": "string", "minLength": 1},
    "tool_policy_version": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "purpose"],
      "properties": {
        "producer_node": {"type": "string", "minLength": 1},
        "producer_task_id": {"type": "string", "format": "uuid"},
        "source_plan_version": {"type": "integer", "minimum": 1},
        "tool_schema_version": {"type": "string", "minLength": 1},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "kind": {"type": "string", "minLength": 1},
        "content_type": {"enum": ["application/json", "text/plain", "application/octet-stream"]},
        "artifact_id": {"type": "string", "format": "uuid"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "purpose": {"type": "string", "maxLength": 512}
      }
    }}
  }
}
