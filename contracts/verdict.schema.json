{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mgar/v2/verdict.schema.json",
  "title": "MGAR Independent Verdict V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "status", "checks", "verifier_version"],
  "properties": {
    "schema_version": {"const": "verdict.v1"},
    "artifact_id": {"type": "string", "format": "uuid"},
    "status": {"type": "string", "enum": ["passed", "failed", "unverifiable"]},
    "verifier_version": {"type": "string", "minLength": 1},
    "checks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["name", "status", "detail"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "status": {"type": "string", "enum": ["passed", "failed", "unverifiable"]},
        "detail": {"type": "string"}
      }
    }}
  }
}
