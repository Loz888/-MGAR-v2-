{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mgar/v2/agent_result.schema.json",
  "title": "MGAR unverified SDK Agent Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","run_id","trace_id","task_id","plan_version","owner","epoch","revision","case_id","status","turns","tool_calls","verified","output","error_kind","error_turn","error_tool","observations","events"],
  "properties": {
    "schema_version": {"const":"agent_result.v1"},
    "run_id":{"type":"string","format":"uuid"},
    "trace_id":{"type":"string","format":"uuid"},
    "task_id":{"type":"string","format":"uuid"},
    "plan_version":{"type":"integer","minimum":1},
    "owner":{"type":"string","minLength":1,"maxLength":128},
    "epoch":{"type":"integer","minimum":1},
    "revision":{"type":"integer","minimum":0},
    "case_id":{"type":"string","minLength":1,"maxLength":128},
    "status":{"enum":["completed","failed"]},
    "turns":{"type":"integer","minimum":0,"maximum":64},
    "tool_calls":{"type":"integer","minimum":0,"maximum":64},
    "verified":{"const":false},
    "output":{"type":["object","null"]},
    "error_kind":{"type":["string","null"]},
    "error_turn":{"type":["integer","null"],"minimum":0,"maximum":64},
    "error_tool":{"type":["string","null"]},
    "observations":{"type":"array","maxItems":64,"items":{
      "type":"object","additionalProperties":false,
      "required":["turn","call_id","name","status","output","output_sha256"],
      "properties":{
        "turn":{"type":"integer","minimum":1,"maximum":64},
        "call_id":{"type":"string","minLength":1,"maxLength":64},
        "name":{"type":"string","minLength":1,"maxLength":64},
        "status":{"enum":["ok","error"]},
        "output":{},
        "output_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
      }
    }},
    "events":{"type":"array","minItems":1,"maxItems":512,"items":{
      "type":"object","additionalProperties":false,
      "required":["sequence","kind","turn","tool_name","call_id","observation_hash","error_kind"],
      "properties":{
        "sequence":{"type":"integer","minimum":1},
        "kind":{"enum":["run_started","model_requested","model_decided","tool_requested","tool_observed","run_completed","run_failed"]},
        "turn":{"type":"integer","minimum":0,"maximum":64},
        "tool_name":{"type":["string","null"]},
        "call_id":{"type":["string","null"]},
        "observation_hash":{"type":["string","null"]},
        "error_kind":{"type":["string","null"]}
      }
    }}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"completed"}}},"then":{"properties":{"output":{"type":"object"},"error_kind":{"type":"null"},"error_turn":{"type":"null"},"error_tool":{"type":"null"}}}},
    {"if":{"properties":{"status":{"const":"failed"}}},"then":{"properties":{"output":{"type":"null"},"error_kind":{"type":"string","minLength":1},"error_turn":{"type":"integer","minimum":0}}}}
  ]
}
